{
  "openapi": "3.0.3",
  "info": {
    "title": "Campus classroom approval API",
    "version": "0.2.0-member03",
    "description": "Member03 Phase8/9 implementation draft; external M1/D interfaces and shared Web entry require their owners and independent review. No real cross-service success is claimed by response fixtures."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "UserBearer": []
    }
  ],
  "paths": {
    "/api/v1/classroom-requests": {
      "post": {
        "operationId": "submitClassroomRequest",
        "summary": "Submit a future classroom request",
        "description": "Requires STUDENT and classroom:apply. Authenticated actor supplies applicantId. Enabled CLASSROOM only. Offset timestamps, microsecond precision, start strictly future, end after start; M1 four-hour limit does not apply. Creates SUBMITTED with ROOM_ADMIN pending and DEPARTMENT_ADMIN waiting.",
        "responses": {
          "201": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              },
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative new request URI"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Submit"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listClassroomRequests",
        "summary": "Read own requests or current approval inbox",
        "description": "mine is authenticated owner-only, ordered submittedAt/id descending. pending requires classroom:approve and an approval role; explicit room scope/current pending stage/different applicant and prior approver are checked before pagination, ordered deadline/id. No implicit SYSTEM_ADMIN override.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "mine",
                "pending"
              ],
              "default": "mine"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/api/v1/classroom-requests/{id}": {
      "get": {
        "operationId": "getClassroomRequest",
        "summary": "Read a coherent request, steps, decisions and events",
        "description": "Owner or currently permissioned/scoped ROOM_ADMIN or DEPARTMENT_ADMIN. Others get404. Repeatable-read snapshot; no claim tokens or private credentials exposed.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/classroom-requests/{id}/approve": {
      "post": {
        "operationId": "approveClassroomRequest",
        "summary": "Approve the current stage",
        "description": "Current classroom:approve plus matching stage role and explicit room scope. No self approval or same human twice. Recheck deadline after row lock. First→APPROVING; second→APPROVED_PENDING_SYNC only. Real M1 failure remains SYNC_FAILED; HTTP operation does not pretend occupancy success.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/classroom-requests/{id}/reject": {
      "post": {
        "operationId": "rejectClassroomRequest",
        "summary": "Reject the current stage",
        "description": "Same stage role/permission/scope and actor separation as approval. Atomic single action/step/request/event; terminal REJECTED. Deadline rechecked after lock.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/classroom-requests/{id}/cancel": {
      "post": {
        "operationId": "cancelClassroomRequest",
        "summary": "Cancel own unfinished approval",
        "description": "Applicant: pending approvals before deadline/start; unattempted pending occupancy before start; or confirmed APPROVED before start. Confirmed occupancy queues RELEASING and only exact M1 release acknowledgement makes CANCELLED. Attempted/uncertain creates require authorized recovery first. At endAt, a scheduler releases APPROVED requests and confirms COMPLETED.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/classroom-requests/{id}/recover": {
      "post": {
        "operationId": "recoverClassroomSynchronization",
        "summary": "Explicit authorized synchronization recovery with a required reason",
        "description": "Current scoped classroom approver (not applicant), or current PROPERTY_MANAGER with maintenance:assign, respectively. SYNC_FAILED only. One real idempotent HTTP attempt per explicit request. Original automatic attempts/history are retained; no force-success state. Unknown or mismatched receipts remain failed.",
        "responses": {
          "200": {
            "description": "Success; state is explicit in data",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Matches response requestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "D user JWT forwarded only to D; M2 verifies current identity/scopes via HTTP"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "roomId",
          "startAt",
          "endAt",
          "purpose"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        }
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "applicantId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "roomId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "purpose": {
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "APPROVING",
              "APPROVED_PENDING_SYNC",
              "APPROVED",
              "REJECTED",
              "CANCELLED",
              "AUTO_CANCELLED",
              "SYNC_FAILED",
              "RELEASING",
              "COMPLETED"
            ]
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "approvalDueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "syncAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "syncError": {
            "type": "string",
            "nullable": true
          },
          "occupancyId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "syncOperation": {
            "type": "string",
            "enum": [
              "BLOCK",
              "RELEASE"
            ]
          },
          "releaseReason": {
            "type": "string",
            "nullable": true,
            "enum": [
              "CANCEL",
              "EXPIRED",
              null
            ]
          }
        },
        "required": [
          "id",
          "applicantId",
          "roomId",
          "startAt",
          "endAt",
          "purpose",
          "status",
          "submittedAt",
          "updatedAt",
          "approvalDueAt",
          "syncAttempts",
          "syncError",
          "occupancyId"
        ]
      },
      "Step": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "requestId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "stepNumber": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "requiredRole": {
            "type": "string",
            "enum": [
              "ROOM_ADMIN",
              "DEPARTMENT_ADMIN"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "WAITING",
              "PENDING",
              "APPROVED",
              "REJECTED",
              "CANCELLED",
              "EXPIRED"
            ]
          },
          "actorId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "requestId",
          "stepNumber",
          "requiredRole",
          "status",
          "actorId",
          "decidedAt",
          "dueAt"
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "requestId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "stepNumber": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "actorId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "requestId",
          "stepNumber",
          "actorId",
          "action",
          "reason",
          "occurredAt"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "requestId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "actorId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "nullable": true,
            "description": "Authorized recovery reason when applicable"
          }
        },
        "required": [
          "id",
          "requestId",
          "actorId",
          "action",
          "traceId",
          "occurredAt"
        ]
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request": {
            "$ref": "#/components/schemas/Request"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": [
          "request",
          "steps",
          "actions",
          "events"
        ]
      },
      "RequestEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Request"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "DetailEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Detail"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "ListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Invalid body/parameters or unknown fields",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Invalid or missing user credential",
        "content": {
          "application/json": {
