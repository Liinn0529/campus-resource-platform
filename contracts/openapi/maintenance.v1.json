{
  "openapi": "3.0.3",
  "info": {
    "title": "Campus maintenance work order API",
    "version": "0.1.0",
    "description": "Phase7 reviewable draft. DueAt/default24h and role/acceptance policies await human review. Real M1 blocking/release is Phase8; current actual403 is persisted SYNC_FAILED. External receipt fixtures are explicitly test-only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080"
    }
  ],
  "security": [
    {
      "UserBearer": []
    }
  ],
  "paths": {
    "/api/v1/maintenance-tickets": {
      "post": {
        "operationId": "reportMaintenance",
        "summary": "提交报修",
        "description": "Current STUDENT with maintenance:report; enabled room, authenticated reporter. Creates REPORTED and event atomically.",
        "responses": {
          "201": {
            "description": "Explicit persisted result; pending synchronization is not completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketEnvelope"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listMaintenance",
        "summary": "查询工单",
        "description": "mine is current reporter; assigned requires current PROPERTY_STAFF; managed requires current PROPERTY_MANAGER and maintenance:assign. SQL visibility filter precedes pagination.",
        "responses": {
          "200": {
            "description": "Explicit persisted result; pending synchronization is not completion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListEnvelope"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "422": {
            "$ref": "#/components/responses/422"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "view",
            "schema": {
              "type": "string",
              "enum": [
                "mine",
                "assigned",
                "managed"
              ],
              "default": "mine"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
