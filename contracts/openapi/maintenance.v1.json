    "/api/v1/maintenance-tickets/{id}/accept": {
      "post": {
        "operationId": "acceptMaintenance",
        "summary": "验收并请求恢复",
        "description": "Reporter only; WAITING_ACCEPTANCE without queued sync. Retains WAITING_ACCEPTANCE and queues RELEASE. Only matching RELEASED receipt permits COMPLETED; failures retain SYNC_FAILED with occupancy reference.",
        "responses": {
          "200": {
            "description": "Explicit persisted result; pending synchronization is not completion",
