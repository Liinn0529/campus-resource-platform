  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "D user JWT forwarded only to D; M3 reads current identity over real HTTP"
      }
    },
    "schemas": {
      "Report": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "roomId",
          "description"
        ],
        "additionalProperties": false
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "assigneeId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "assigneeId"
        ],
        "additionalProperties": false
      },
      "Note": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "note"
        ],
        "additionalProperties": false
      },
      "Rating": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        },
        "required": [
          "rating"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "reporterId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "roomId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "REPORTED",
              "ASSIGNED",
              "BLOCKING_ROOM",
              "IN_PROGRESS",
              "WAITING_ACCEPTANCE",
              "COMPLETED",
              "CANCELLED",
              "SYNC_FAILED"
            ]
          },
          "assigneeId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "reportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "repairCycle": {
            "type": "integer",
            "minimum": 0
          },
          "escalated": {
            "type": "boolean"
          },
          "blockStartAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "occupancyId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "syncOperation": {
            "type": "string",
            "nullable": true,
            "enum": [
              "BLOCK",
              "RELEASE",
              null
            ]
          },
          "syncAttempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "syncError": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "reporterId",
          "roomId",
          "description",
          "status",
          "assigneeId",
          "reportedAt",
          "updatedAt",
          "dueAt",
          "repairCycle",
          "escalated",
          "blockStartAt",
          "occupancyId",
          "syncOperation",
          "syncAttempts",
          "syncError"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "ticketId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "actorUserId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true
          },
          "action": {
            "type": "string"
          },
          "repairCycle": {
            "type": "integer"
          },
          "note": {
